"""Consultas disponibles para los clientes de Rentar."""
type Query {
    """
    Busca vehículos activos y sin reservas superpuestas durante todo el período indicado.
    Las reservas canceladas no bloquean la disponibilidad.
    """
    vehiculosDisponibles(filtro: DisponibilidadFiltroInput!): [VehiculoDisponible!]!

     """Consulta el historial propio. El administrador debe indicar clienteId; un cliente puede omitirlo."""
    historialAlquileres(clienteId: ID): [HistorialAlquiler!]!

    """Consulta reservas con filtros opcionales. El cliente solo accede a sus reservas; el administrador puede consultar todas. Las fechas delimitan reservas contenidas en el rango."""
    reservas(filtro: ReservaFilterInput): [Reserva!]!
}

"""Filtros para consultar disponibilidad. Inicio y fin usan formato ISO-8601."""
input DisponibilidadFiltroInput {
    tipoVehiculo: TipoVehiculo
    marca: String
    modelo: String
    precioMinimo: Float
    precioMaximo: Float
    """Ejemplo: 2026-10-01T10:00:00"""
    fechaInicio: String!
    """Ejemplo: 2026-10-05T10:00:00"""
    fechaFin: String!
}

"""Vehículo disponible para alquilar durante el período solicitado."""
type VehiculoDisponible {
    patente: String!
    marca: String!
    modelo: String!
    anio: Int!
    color: String
    tipoVehiculo: TipoVehiculo!
    precioDiario: Float!
}

enum TipoVehiculo {
    SEDAN
    SUV
    PICKUP
    COUPE
    HATCHBACK
}

"""Registro perteneciente al historial de alquileres de un cliente."""
type HistorialAlquiler {
    vehiculo: VehiculoHistorial!
    patente: String!
    fechaInicio: String!
    fechaFin: String!
    cantidadDias: Int!
    importeTotal: Float!
    estado: EstadoReserva!
}

"""Datos identificatorios del vehículo alquilado."""
type VehiculoHistorial {
    marca: String!
    modelo: String!
}

enum EstadoReserva {
    PENDIENTE
    CONFIRMADA
    CANCELADA
    TERMINADA
}

"""Filtros opcionales combinados con AND. Fechas ISO-8601 sin zona horaria."""
input ReservaFilterInput {
    clienteId: ID
    vehiculoId: ID
    tipoVehiculo: TipoVehiculo
    estadoReserva: EstadoReserva
    fechaDesde: String
    fechaHasta: String
}

"""Reserva con datos del cliente, vehículo y precio diario guardado al reservar."""
type Reserva {
    id: ID!
    cliente: Cliente!
    vehiculo: Vehiculo!
    patente: String!
    horaInicio: String!
    horaFin: String!
    duracionDias: Int!
    precioDiarioHistorico: Float!
    importeTotal: Float!
    estadoReserva: EstadoReserva!
}

type Cliente {
    id: ID!
    nombre: String!
    apellido: String!
    documento: String!
}

type Vehiculo {
    id: ID!
    patente: String!
    marca: String!
    modelo: String!
    tipoVehiculo: TipoVehiculo!
}

